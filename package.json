{
  "name": "@swaraj792725/sparsify-ts",
  "version": "1.0.0",
  "description": "Ultra-fast, zero-dependency, type-safe sparse matrix & vector computation engine for Node.js & TypeScript",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swaraj792725/sparsify-ts.git"
  },
  "keywords": [
    "sparse-matrix",
    "sparse-vector",
    "linear-algebra",
    "csr",
    "coo",
    "math",
    "typescript",
    "zero-dependency",
    "nodejs"
  ],
  "author": "Swaraj Jakanoor <169044732+swaraj792725@users.noreply.github.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/swaraj792725/sparsify-ts/issues"
  },
  "homepage": "https://github.com/swaraj792725/sparsify-ts#readme",
  "devDependencies": {
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5",
    "tsup": "^8.0.2",
    "vitest": "^1.6.0"
  }
}
